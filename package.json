{
  "name": "marble-studio",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test:spiral": "node tests/spiral.mjs && node tests/spiral-browser.mjs",
    "test:workspaces": "node tests/studio-workspaces.mjs",
    "test:stories": "python tests/statistics-stories.py && node tests/statistics-library.mjs && node tests/statistics-library-browser.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "test": "node scripts/check.mjs",
    "test:browser": "node tests/browser.mjs",
    "test:recording": "node tests/recording-start-browser.mjs",
    "test:statistics": "node tests/statistics.mjs && node tests/statistics-browser.mjs",
    "test:statistics-library": "node tests/statistics-library.mjs && node tests/statistics-library-browser.mjs",
    "test:visual": "node tests/render-quality.mjs",
    "test:images": "node tests/ball-images.mjs",
    "test:effects": "node tests/effect-colors.mjs",
    "test:arena": "node tests/arena.mjs && node tests/arena-browser.mjs",
    "test:catalog": "node tests/catalog-browser.mjs && node tests/catalog-fill.mjs",
    "test:presentation": "node tests/presentation.mjs && node tests/presentation-browser.mjs",
    "test:editor": "node tests/editor-data.mjs && node tests/new-sections.mjs",
    "factory": "node scripts/factory-server.mjs",
    "test:factory": "node tests/factory.mjs",
    "test:generation": "node tests/generation-effects.mjs && node tests/spiral-audio-browser.mjs",
    "check": "node scripts/check.mjs --browser",
    "check:export": "node scripts/check.mjs --export",
    "test:production": "node tests/production-data.mjs",
    "test:production-browser": "node tests/production-browser.mjs"
  },
  "dependencies": {
    "matter-js": "0.20.0",
    "vite": "7.3.6"
  },
  "devDependencies": {
    "ffmpeg-static": "^5.3.0",
    "playwright": "1.58.2"
  }
}
